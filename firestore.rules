rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enforce userId matching active authenticated credentials
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Enforce userId matching on academicData subcollection
      match /academicData/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Current draft subcollection
      match /currentDraft/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }


      // Private history snapshot subcollection
      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Private nicknames subcollection
      match /nicknames/{studentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Two-level Student Profiles and Calculations subcollections
      match /resultProfiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        match /calculations/{calculationId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Private profiles subcollection (legacy)
      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }


    // Public student profiles lookup (read-only for all logged-in users, writeable only by the profile owner)
    match /publicProfiles/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (resource == null || resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == request.auth.uid);
    }
  }
}
