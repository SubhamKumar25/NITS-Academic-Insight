rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enforce userId matching active authenticated credentials for users tree and all subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public student profiles lookup (read-only for all logged-in users, writeable only by the profile owner)
    match /publicProfiles/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (resource == null || resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == request.auth.uid);
    }
  }
}

